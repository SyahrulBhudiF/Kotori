{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "mdx"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "alchemy.run.ts"]
}
