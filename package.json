{
  "name": "japanese-n5-check",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "build:css": "panda codegen && panda cssgen && node scripts/build-css.mjs",
    "check:styles": "node scripts/check-styles.mjs",
    "deploy": "alchemy deploy --stage prod",
    "destroy": "alchemy destroy --stage prod"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "^2.0.0-beta.87",
    "@effect/platform-node": "^4.1.5",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@pandacss/dev": "^0.53.4",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.7",
    "alchemy": "^2.0.0-beta.87",
    "effect": "^4.1.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.7.0"
  }
}
